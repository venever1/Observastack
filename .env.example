# App
APP_ENV=development
APP_PORT=8080
# REQUIRED. Generate with: openssl rand -base64 32
# Placeholder below is intentionally invalid — replace before starting the stack.
JWT_SECRET=changeme_replace_with_openssl_rand_base64_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Cross-origin allowlist for browser clients, comma-separated.
# Example: https://app.example.com,https://admin.example.com
# Format: full origins including scheme and port, e.g. https://app.example.com:5173
# Wildcards ("*") are rejected — the app refuses to start. List every origin explicitly.
# Leave unset (or empty) to block all cross-origin requests; same-origin and
# non-browser clients (curl, server-to-server) are unaffected.
ALLOWED_ORIGINS=

# Max request body accepted by the API, in bytes.
# Optional — defaults to 1048576 (1 MiB) when unset.
# Value MUST be a plain integer number of bytes. Unit suffixes are rejected:
# write 1048576, NOT "1MB" or "10MB". The app refuses to start on a bad value
# rather than silently falling back to the default.
# Requests declaring a larger Content-Length get 413 Payload Too Large.
MAX_REQUEST_BODY_SIZE=1048576

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=observastack
POSTGRES_PASSWORD=change_me
POSTGRES_DB=observastack

# Redis
# Required: the app fails to start if it cannot reach Redis, because the login
# rate limiter depends on it.
REDIS_HOST=redis
REDIS_PORT=6379
# Optional. Leave empty for an unauthenticated Redis.
REDIS_PASSWORD=
REDIS_DB=0

# Trust X-Forwarded-For when resolving the client IP for rate limiting.
# Set to true ONLY when a proxy you control (e.g. Traefik) sits in front of the
# app. Leaving it false is correct when clients connect directly: the header is
# attacker-controlled, and trusting it lets anyone forge a new IP per request
# and bypass every per-IP limit.
TRUSTED_PROXY=false

# Fixed-window rate limiting. Values are plain integers, not durations with
# suffixes; an unparsable value is rejected at startup rather than silently
# falling back, so a typo can never quietly weaken a limit.
# Window shared by all limits below.
RATE_LIMIT_WINDOW=1m
# Per client IP, per window. Stops one host spraying many accounts.
RATE_LIMIT_LOGIN_IP_REQUESTS=20
# Per target account, per window. Tighter than the IP limit, so a botnet cannot
# grind a single account.
RATE_LIMIT_LOGIN_EMAIL_REQUESTS=10
# Per client IP, per window, for account creation.
RATE_LIMIT_REGISTER_IP_REQUESTS=10
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_TRACE_SAMPLE_RATIO=0.1
LOKI_URL=http://loki:3100
PROMETHEUS_PORT=9090
